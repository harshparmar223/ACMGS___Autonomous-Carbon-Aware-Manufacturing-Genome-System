# ACMGS Environment Configuration Template
# Copy to .env and customize as needed

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Streamlit Cockpit
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost

# Database Configuration
DATABASE_URL=sqlite:///./data/acmgs.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://acmgs_user:password@localhost:5432/acmgs_db

# Neo4j Knowledge Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=acmgs_secret

# Cyber-Physical Hardware / Edge Configuration
ESP32_HOST=192.168.1.100
ESP32_PORT=5000
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200
USE_SIMULATED_HARDWARE=true

# Dynamic Carbon Dispatch Thresholds (gCO2/kWh)
CARBON_CLEAN_THRESHOLD=150.0
CARBON_CONSERVATION_THRESHOLD=400.0

# MOSFET Actuator Tuning
MOSFET_PWM_PIN=18
MOSFET_PWM_FREQ=25000
MOSFET_MAX_DUTY=255
